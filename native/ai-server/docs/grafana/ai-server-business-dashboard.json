    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-2"
      },
      "description": "所选实例与协议上的完成请求速率（ai_server_requests_total）。",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-2"
          },
          "editorMode": "code",
          "expr": "sum(rate(ai_server_requests_total{job=~\"$job\",instance=~\"$instance\",protocol=~\"$protocol\"}[$__rate_interval]))",
          "legendFormat": "req/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "请求速率",
      "type": "stat"
    },
