          "editorMode": "code",
          "expr": "100 * sum(rate(ai_server_requests_total{job=~\"$job\",instance=~\"$instance\",protocol=~\"$protocol\",result=\"success\"}[$__rate_interval])) / clamp_min(sum(rate(ai_server_requests_total{job=~\"$job\",instance=~\"$instance\",protocol=~\"$protocol\"}[$__rate_interval])), 1e-9)",
