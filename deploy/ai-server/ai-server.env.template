AI_SERVER_LISTEN_ADDRESS=0.0.0.0
AI_SERVER_LISTEN_PORT=8080
AI_SERVER_ADVERTISE_ADDRESS=${AI_SERVER_ADVERTISE_ADDRESS}
AI_SERVER_SERVICE_NAME=fiber-ai-server
AI_SERVER_SERVICE_GROUP=DEFAULT_GROUP
AI_SERVER_ZONE=demo
AI_SERVER_CLUSTER=local
AI_SERVER_INITIAL_CONFIG_TIMEOUT_MS=120000
# Upstream provider HTTP/1 idle-connection pool, per worker shard (process-wide
# ceilings are these values times the worker count). 0 disables idle pooling.
AI_SERVER_POOL_MAX_IDLE_PER_GROUP=100
AI_SERVER_POOL_MAX_IDLE_TOTAL=10000
AI_SERVER_POOL_IDLE_TIMEOUT_MS=30000
AI_SERVER_LOG_CONFIG_PATH=/etc/ai-server/logging.json
AI_SERVER_INSTANCE_ID=${AI_SERVER_INSTANCE_ID}
AUDIT_INGEST_TOKEN=${AUDIT_INGEST_TOKEN}
AUDIT_HTTP_QUEUE_CAPACITY_BYTES=${AUDIT_HTTP_QUEUE_CAPACITY_BYTES}
AUDIT_HTTP_BATCH_SIZE=${AUDIT_HTTP_BATCH_SIZE}
AUDIT_HTTP_BATCH_MAX_BYTES=${AUDIT_HTTP_BATCH_MAX_BYTES}
AUDIT_HTTP_FLUSH_INTERVAL_MS=${AUDIT_HTTP_FLUSH_INTERVAL_MS}
AUDIT_HTTP_CONNECT_TIMEOUT_MS=${AUDIT_HTTP_CONNECT_TIMEOUT_MS}
AUDIT_HTTP_REQUEST_TIMEOUT_MS=${AUDIT_HTTP_REQUEST_TIMEOUT_MS}

NACOS_SERVER_ADDRESSES=${NACOS_SERVER_ADDRESSES}
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_NAMESPACE_ID=public
NACOS_TENANT=
NACOS_USERNAME=${NACOS_USERNAME}
NACOS_PASSWORD=${NACOS_PASSWORD}
NACOS_CLIENT_VERSION=fiber-ai-server/demo

CAT_APP_KEY=fiber-ai-server
CAT_HOSTNAME=ai-server-demo-1
CAT_IP=${AI_SERVER_ADVERTISE_ADDRESS}
CAT_ROUTER_ADDRESSES=
CAT_COLLECTOR_ADDRESSES=${CAT_COLLECTOR_ADDRESSES}
