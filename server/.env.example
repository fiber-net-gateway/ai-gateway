# API listener and browser origin
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:5173

# memory is intended only for local preview and deterministic tests. Use mysql in production.
APP_DATA_MODE=memory

# Generate with: openssl rand -base64 32
# Production refuses to start without an explicitly supplied key.
APP_ENCRYPTION_KEY=REREREREREREREREREREREREREREREREREREREREREQ=
AUTH_COOKIE_SECURE=false

# development accepts a provisioned username. Use oidc outside local development.
AUTH_MODE=development
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=enterprise-oidc

# Initial administrator and local environment. In OIDC mode, the subject must match the IdP.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_EXTERNAL_SUBJECT=admin
BOOTSTRAP_ENVIRONMENT_ID=00000000-0000-4000-8000-000000000001
BOOTSTRAP_ENVIRONMENT_NAME=本地开发环境
BOOTSTRAP_ENVIRONMENT_STAGE=development
BOOTSTRAP_BT1_KID=dev-key
# Local-only signing secret. Generate a distinct 32-byte value for each real environment.
BOOTSTRAP_BT1_SECRET_BASE64=QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI=
BOOTSTRAP_BT1_CLOCK_SKEW_SECONDS=60

# MySQL stores users, sessions, token metadata, encrypted delivery windows, and audits.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_server_console
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=ai_server_console
MYSQL_CONNECTION_LIMIT=10

# rnacos is the Nacos-compatible configuration and naming service used by ai-server.
RNACOS_ENVIRONMENT_ID=00000000-0000-4000-8000-000000000001
RNACOS_BASE_URL=http://127.0.0.1:8848
RNACOS_NAMESPACE_ID=public
RNACOS_TENANT=
RNACOS_USERNAME=
RNACOS_PASSWORD=
RNACOS_CONFIG_GROUP=LLM-SERVER
# Enable only when this process has a stable address reachable by ai-server.
RNACOS_REGISTRATION_ENABLED=false
CONSOLE_API_ADVERTISE_ADDRESS=127.0.0.1
CONSOLE_API_ADVERTISE_PORT=3000
CONSOLE_API_NACOS_CLUSTER=DEFAULT
RNACOS_REGISTRATION_HEARTBEAT_MS=5000

# Target ai-server management endpoint. Do not point this at an untrusted host.
AI_SERVER_BASE_URL=http://127.0.0.1:8080

# Optional internal endpoint used by ai-server async audit delivery.
# Generate at least 32 random bytes. Empty disables the ingest endpoint.
AUDIT_INGEST_TOKEN=
AUDIT_INGEST_BODY_LIMIT_BYTES=8388608
